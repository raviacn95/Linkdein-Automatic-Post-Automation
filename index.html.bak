    <main class="layout">
      <section class="panel composer" aria-labelledby="composer-title">
        <h2 id="composer-title">Write Post</h2>
        <form id="post-form">
          <input type="hidden" id="post-id" />

          <label for="title">Title</label>
          <input id="title" name="title" type="text" placeholder="Ex: Playwright Retry Strategy for Flaky UI" required />

          <label for="category">Category</label>
          <select id="category" name="category" required>
            <option value="">Select category</option>
            <option value="JavaScript">JavaScript</option>
            <option value="TypeScript">TypeScript</option>
            <option value="Playwright">Playwright</option>
            <option value="MCP">MCP</option>
            <option value="TOSCA">TOSCA</option>
            <option value="Both">Both</option>
          </select>

          <label for="tags">Tags (comma separated)</label>
          <input id="tags" name="tags" type="text" placeholder="automation, selectors, regression" />

          <label for="excerpt">Short Summary</label>
          <textarea id="excerpt" name="excerpt" rows="3" placeholder="Two-line summary for card view" required></textarea>

          <label for="cover-image">Cover Image</label>
          <input id="cover-image" name="cover-image" type="file" accept="image/*" />
          <img id="cover-preview" class="cover-preview hidden" alt="Cover preview" />

          <label for="content">Full Content</label>
          <textarea id="content" name="content" rows="10" placeholder="Write your post details here..." required></textarea>
          <p class="hint">Markdown supported: headings, lists, bold, italics, links, code blocks.</p>

          <div class="button-row">
            <button class="btn-primary" type="submit" id="save-btn">Publish Post</button>
            <button class="btn-ghost" type="button" id="clear-btn">Clear</button>
          </div>
        </form>
      </section>

      <section class="panel feed" aria-labelledby="feed-title">
        <div class="feed-head">
          <h2 id="feed-title">Published Posts</h2>
          <div class="toolbar">
            <input id="search" type="search" placeholder="Search title, tag, text..." />
            <select id="filter-category">
              <option value="All">All Categories</option>
              <option value="JavaScript">JavaScript</option>
              <option value="TypeScript">TypeScript</option>
              <option value="Playwright">Playwright</option>
              <option value="MCP">MCP</option>
              <option value="TOSCA">TOSCA</option>
              <option value="Both">Both</option>
            </select>
            <button id="export-btn" class="btn-ghost" type="button">Export JSON</button>
            <button id="import-btn" class="btn-ghost" type="button">Import JSON</button>
            <input id="import-file" type="file" accept="application/json" class="hidden" />
          </div>
        </div>

        <div id="posts" class="posts" aria-live="polite"></div>
      </section>
    </main>

    <dialog id="viewer" class="viewer">
      <article id="viewer-content"></article>
      <form method="dialog">
