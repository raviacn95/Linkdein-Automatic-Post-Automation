    <!-- Structured Data: Blog -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Blog",
      "name": "JS Playwright MCP Knowledge Hub",
      "url": "https://raviacn95.github.io/js-playwright-mcp-blog/",
      "description": "Comprehensive learning resource with 100+ detailed tutorial guides covering JavaScript, Playwright, and TypeScript from beginner to architect level with code examples, comparison tables, best practices, and FAQs",
      "blogPost": [
        {
          "@type": "BlogPosting",
          "headline": "JS Variables: var, let & const",
          "description": "Understand scoping rules and when to pick var, let, or const.",
          "keywords": "javascript, variables, basics"
        },
        {
          "@type": "BlogPosting",
          "headline": "What is Playwright & Key Features",
          "description": "Open-source E2E framework by Microsoft with cross-browser, auto-wait, and parallel execution.",
          "keywords": "playwright, overview, features"
        },
        {
          "@type": "BlogPosting",
          "headline": "What is MCP (Model Context Protocol)?",
          "description": "MCP is NOT a test framework — it's a protocol standardizing how AI models, tools, and context communicate.",
          "keywords": "mcp, protocol, ai-testing"
        }
      ]
    }
    </script>

    <!-- Structured Data: FAQ (boosts SEO) -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is Playwright and what are its key features?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Playwright is an open-source automation framework by Microsoft for end-to-end testing. Key features include cross-browser support, auto-wait mechanism, multi-language support, mobile emulation, network interception, and parallel test execution."
          }
        },
        {
          "@type": "Question",
          "name": "What is MCP (Model Context Protocol)?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "MCP is a protocol that standardizes how AI models, tools like Playwright, and context like DOM and logs communicate in a structured, machine-actionable way. It is not a test framework but a communication bridge."
          }
        },
        {
          "@type": "Question",
          "name": "What is the difference between var, let, and const in JavaScript?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "var is function-scoped and can be redeclared. let is block-scoped and can be updated but not redeclared. const is block-scoped and cannot be updated or redeclared. Modern JS prefers let and const."
          }
        }
      ]
    }
    </script>

