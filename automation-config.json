{
  "scheduler": {
    "enabled": true,
    "intervalMinutes": 60,
    "intervalJitterPercent": 20,
    "runImmediately": true,
    "maxRuns": 0
  },
  "linkedin": {
    "postCount": 2,
    "startIndex": 0,
    "delayBetweenPostsMinSec": 20,
    "delayBetweenPostsMaxSec": 45,
    "prePostDelayMinSec": 2,
    "prePostDelayMaxSec": 4
  },
  "safetyLimits": {
    "maxPostsPerDay": 26,
    "similarityThreshold": 0.6,
    "maxHistory": 50
  },
  "contentGeneration": {
    "sourceMode": "topics",
    "targetPostCount": 20,
    "pdfSourceDir": "C:\\Users\\ravir\\Music\\Post Every 1 mintues\\Pdfs",
    "pdfPath": "",
    "promptForPdfPath": true,
    "defaultCategory": "DSA",
    "autoGenerateOnEveryRun": true,
    "topicPool": [
      "DSA",
      "System Design"
    ],
    "tags": [
      "javascript",
      "automation"
    ],
    "outputFile": "posts-data.js"
  },
  "aiGeneration": {
    "enabled": false,
    "endpoint": "https://api.openai.com/v1/chat/completions",
    "model": "gpt-4o-mini",
    "apiKeyEnvVar": "OPENAI_API_KEY",
    "systemPrompt": "Generate high-quality technical social posts as valid JSON only."
  },
  "freeAiGeneration": {
    "enabled": true,
    "provider": "copilot",
    "multiProvider": true,
    "concurrentWorkers": 20,
    "batchDelayMs": 0,
    "maxRetriesPerProvider": 1,
    "copilot": {
      "apiKeyEnvVar": "GITHUB_TOKEN",
      "model": "gpt-4o-mini",
      "minIntervalMs": 65000
    },
    "groq": {
      "apiKeyEnvVar": "GROQ_API_KEY",
      "model": "llama-3.1-8b-instant"
    },
    "gemini": {
      "apiKeyEnvVar": "GEMINI_API_KEY",
      "model": "gemini-1.5-flash"
    }
  }
}